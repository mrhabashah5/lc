# Copy to .env.local and fill in. Never commit real values.

# Public site details (shown on the website)
NEXT_PUBLIC_SITE_URL=https://smartguru.site
NEXT_PUBLIC_WHATSAPP_NUMBER=923101990325
NEXT_PUBLIC_CONTACT_EMAIL=info@byebyeloan.online
# Real office address (required for Google Ads financial services). Leave empty to hide it.
NEXT_PUBLIC_ADDRESS=

# Admin dashboard (/admin)
ADMIN_PASSWORD=change-me-to-a-long-random-password
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Database (libSQL / Turso)
# Leave both empty for local development: a file at data/loanclear.db is used.
# On Vercel (or any serverless host) these are REQUIRED, or form submissions are lost.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email notifications (optional). Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartGuru <info@byebyeloan.online>"
# Where new consultation requests and contact messages are sent
MAIL_TO=info@byebyeloan.online

# Search engines and analytics (optional; nothing loads until set)
# Google Search Console HTML-tag verification code (content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification code (msvalidate.01 content value)
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
# Meta Pixel ID (public identifier; this defaults to the site Pixel ID if unset)
NEXT_PUBLIC_META_PIXEL_ID=1841255493813494
